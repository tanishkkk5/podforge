# Supabase — Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — resend.com, used for notification + confirmation emails
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="Profit Streams Podcast <onboarding@resend.dev>"
NOTIFY_EMAIL=tpandey@appliedframeworks.com

# Admin password for the /admin scheduling page (shared by Luke/Laura/Kevin)
ADMIN_PASSWORD=pick-a-password

# Google Sheets — for the auto-populated Guest List in Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-id-from-the-sheets-url
