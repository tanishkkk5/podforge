# Supabase — Project Settings -> API
# Use the REAL project URL. A copied placeholder (like the example below) once
# made every database feature fail silently.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — resend.com, used for notification + confirmation emails
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="Profit Streams Podcast <onboarding@resend.dev>"
NOTIFY_EMAIL=tpandey@appliedframeworks.com

# One shared admin password for every /admin page (decision 0005).
# Forgot it? Set a new value in Vercel and redeploy.
ADMIN_PASSWORD=pick-a-password

# Google Sheets — for the auto-populated Guest List in Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-id-from-the-sheets-url

# Groq — console.groq.com (free, no credit card). Powers every AI step:
# guest kit extraction, topic tagging, creator captions (decisions 0001, 0002).
GROQ_API_KEY=your-groq-api-key-here

# Voyage AI — voyageai.com (free tier). Embeddings for the Ask Archive search.
# Ask Archive won't work until this is set.
VOYAGE_API_KEY=your-voyage-api-key-here
